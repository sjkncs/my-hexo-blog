{
  "name": "my-hexo-blog",
  "version": "1.0.0",
  "description": "Personal documentation website built with Hexo and Butterfly theme",
  "main": "index.js",
  "scripts": {
    "build": "hexo generate && node tools/check-site.cjs",
    "sync": "node tools/sync-projects.cjs",
    "test": "node --test tests/*.test.cjs",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "dev": "hexo server --debug"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "7.3.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index-pin-top": "^0.2.2",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "3.0.4",
    "aplayer": "1.10.1",
    "cheerio": "1.0.0",
    "hexo-theme-butterfly": "5.5.3"
  },
  "keywords": [
    "hexo",
    "blog",
    "documentation",
    "butterfly"
  ],
  "author": "Yangting SONG",
  "license": "MIT"
}
