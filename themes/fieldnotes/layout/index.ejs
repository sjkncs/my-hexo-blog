<% const posts = site.posts.sort('date', -1).toArray(); const lead = posts.find(p => p.slug === 'shenzhen-research-notes') || posts[0]; const recent = posts.filter(p => p._id !== lead._id && p.categories.toArray().some(c => c.name === '项目经历')).slice(0,2); %>
<div class="site-container home-page">
  <section class="masthead"><div class="eyebrow"><span class="status-dot"></span> NOTES, PROJECTS & THINGS IN BETWEEN</div><h1>Yangting SONG<span class="masthead-period">.</span></h1><div class="masthead-bottom"><p>写代码，做研究，也记录生活。<span>AI Engineering · Research Tools · Urban Computing</span></p><a class="text-link" href="<%- url_for('/about/') %>">关于我 <%- site_icon('arrow-up-right') %></a></div></section>
  <section aria-label="精选文章" class="featured-stories">
    <article class="lead-story"><a class="story-media" href="<%- url_for(lead.path) %>"><img src="<%- url_for(lead.cover || '/img/cover1.jpg') %>" alt="<%= clean_title(lead.title) %>" fetchpriority="high"></a><div class="story-meta"><span><%= category_name(lead) %></span><time datetime="<%= date(lead.date,'YYYY-MM-DD') %>"><%= date(lead.date,'YYYY.MM.DD') %></time><span><%= article_minutes(lead) %> 分钟</span></div><h2><a href="<%- url_for(lead.path) %>"><%= clean_title(lead.title) %></a></h2><p><%= article_summary(lead) %></p><a class="text-link" href="<%- url_for(lead.path) %>">阅读全文 <%- site_icon('arrow-up-right') %></a></article>
    <div class="side-stories"><% recent.forEach(post => { %><article><a class="side-story-media" href="<%- url_for(post.path) %>"><img src="<%- url_for(post.cover || '/img/cover2.jpg') %>" alt="<%= clean_title(post.title) %>" loading="lazy"></a><div class="story-meta"><span><%= category_name(post) %></span><time><%= date(post.date,'YYYY.MM.DD') %></time></div><h3><a href="<%- url_for(post.path) %>"><%= clean_title(post.title) %></a></h3></article><% }) %></div>
  </section>
  <section class="home-projects"><div class="section-heading"><h2>正在构建<span>Selected projects</span></h2><a class="text-link" href="<%- url_for('/projects/') %>">全部项目 <%- site_icon('arrow-up-right') %></a></div><div class="compact-projects"><% site_projects().filter(p=>['agentx','dsh-research','bili-ai-index'].includes(p.name)).forEach((project,i) => { %><a class="compact-project" href="<%= project.html_url %>"><span class="project-number">0<%= i+1 %></span><h3><%= project.title %> <%- site_icon('arrow-up-right') %></h3><p><%= project.summary %></p><span class="project-language"><%= project.language || '资料索引' %></span></a><% }) %></div></section>
  <section class="home-writing"><div class="section-heading"><h2>最近记录<span>Latest writing</span></h2><a class="text-link" href="<%- url_for('/archives/') %>">文章归档 <%- site_icon('arrow-up-right') %></a></div><div class="writing-list"><% posts.slice(0,5).forEach(post => { %><a class="writing-row" href="<%- url_for(post.path) %>"><time><%= date(post.date,'YYYY.MM.DD') %></time><span><%= clean_title(post.title) %></span><span class="writing-category"><%= category_name(post) %></span><%- site_icon('arrow-up-right') %></a><% }) %></div></section>
  <section class="life-band"><div><span class="eyebrow">OFF THE KEYBOARD</span><h2>还有音乐与远方。</h2><p>旋律、旅途，以及屏幕以外的片刻。</p></div><div><a class="text-link" href="<%- url_for('/music/') %>"><%- site_icon('headphones') %> 音乐空间</a><a class="text-link" href="<%- url_for('/2025/01/07/xidi-hongcun-travel/') %>"><%- site_icon('compass') %> 徽州游记</a></div></section>
</div>
