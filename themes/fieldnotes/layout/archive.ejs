<% const posts=page.posts ? page.posts.sort('date',-1).toArray() : site.posts.sort('date',-1).toArray(); %>
<div class="site-container archive-page"><header class="page-heading"><span class="eyebrow">THE WRITING INDEX</span><h1><%= page.tag || page.category || '文章归档' %><span class="heading-period">.</span></h1><p>工程记录、研究笔记，与一些生活片段。</p></header><nav class="archive-categories" aria-label="文章分类"><a href="<%- url_for('/archives/') %>">全部</a><% site.categories.toArray().forEach(c=>{ %><a href="<%- url_for(c.path) %>"><%= c.name %><span><%= c.length %></span></a><% }) %></nav><div class="writing-list"><% posts.forEach(post=>{ %><a class="writing-row" href="<%- url_for(post.path) %>"><time><%= date(post.date,'YYYY.MM.DD') %></time><span><%= clean_title(post.title) %></span><span class="writing-category"><%= category_name(post) %></span><%- site_icon('arrow-up-right') %></a><% }) %></div><nav class="pagination" aria-label="归档分页"><%- paginator({prev_text:'上一页',next_text:'下一页'}) %></nav></div>
