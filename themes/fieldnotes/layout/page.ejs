<div class="site-container document-page"><header class="page-heading"><span class="eyebrow">FIELDNOTES / <%= page.type === 'music' || page.type === 'music-player' ? 'MUSIC' : 'PAGES' %></span><h1><%= clean_title(page.title) %><span class="heading-period">.</span></h1></header><article id="article-container" class="prose"><% if(page.type==='tags'){ %><nav class="archive-categories" aria-label="全部标签"><% site.tags.toArray().forEach(tag=>{ %><a href="<%- url_for(tag.path) %>"><%= tag.name %> <span><%= tag.length %></span></a><% }) %></nav><% }else if(page.type==='categories'){ %><nav class="archive-categories" aria-label="全部分类"><% site.categories.toArray().forEach(c=>{ %><a href="<%- url_for(c.path) %>"><%= c.name %> <span><%= c.length %></span></a><% }) %></nav><% }else{ %><%- page.content %><% } %></article></div>
